# Shared Expo app runtime values.
# Copy this file to `.env.apps` at the repo root when you want one setting to apply to all four apps.

# Shared Supabase auth runtime for all four apps.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
EXPO_PUBLIC_SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
EXPO_PUBLIC_BACKEND_RPC_URL=
# Kill switch for RPC routing: 'split' (default) sends each action to its own
# domain function (feasty-orders/dispatch/partner/admin/account); 'legacy'
# routes everything back through the app-rpc compatibility shim. Recovery
# path is honest, not instant: for these three Expo web apps this value is
# inlined by Metro/Vite at build time, so flipping it means editing the
# relevant deploy workflow's env block and letting CI rebuild + redeploy —
# not a runtime toggle. Installed native mobile builds need an EAS Update or
# a store release to pick up a change.
EXPO_PUBLIC_RPC_MODE=split
EXPO_PUBLIC_FUNCTIONS_REGION=us-central1
EXPO_PUBLIC_SENTRY_DSN=https://YOUR_KEY@YOUR_ORG.ingest.sentry.io/YOUR_PROJECT_ID
EXPO_PUBLIC_APP_ENV=production

# Customer-only Google auth via Supabase.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_CATALOG_URL=https://api.feasty.com.ng

# Host that customer verification and password-reset links point back to.
# It must be the customer app's own host - not the marketing site - or those
# emails send people to the landing page. Partner reads EXPO_PUBLIC_PARTNER_WEB_ORIGIN instead.
EXPO_PUBLIC_APP_DOMAIN=app.feasty.com.ng
