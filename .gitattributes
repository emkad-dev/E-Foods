# packages/domain/src/rpcRoutes.ts is generated by scripts/generate-rpc-routes.mjs,
# which always writes LF. Without this, a Windows checkout with
# core.autocrlf=true checks the committed file out as CRLF, and
# packages/domain/src/rpcRoutes.test.ts's idempotency check (which compares
# the generator's freshly-written LF output against the committed file) then
# reports a false "drift" on every fresh clone. Pin it to LF so the checked-
# out bytes always match what the generator produces.
packages/domain/src/rpcRoutes.ts text eol=lf
