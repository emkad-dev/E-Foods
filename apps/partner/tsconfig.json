{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Tests import the module under test by its .ts path, the way dispatch and
    // customer already do, so the source stays the single copy. Metro does the
    // transpiling; tsc only typechecks.
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
