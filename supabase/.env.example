# Supabase Auth Google provider (SERVER-side). Keep this configured.
# The customer app no longer has a native Google sign-in button, but existing
# accounts were created through Google and have no password, so the provider
# must stay enabled or those users are locked out.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID="YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com"
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
