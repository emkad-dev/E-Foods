{
  "name": "feasty-platform",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:admin": "npm --prefix apps/admin-web run dev",
    "dev:customer": "npm --prefix apps/customer run start",
    "dev:partner": "npm --prefix apps/partner run start",
    "dev:dispatch": "npm --prefix apps/dispatch run start",
    "build:admin": "npm --prefix apps/admin-web run build",
    "build:partner": "npm --prefix apps/partner run build:web",
    "typecheck:partner": "npm --prefix apps/partner run typecheck",
    "typecheck:customer": "npm --prefix apps/customer run typecheck",
    "typecheck:dispatch": "npm --prefix apps/dispatch run typecheck",
    "android:customer": "npm --prefix apps/customer run android",
    "android:partner": "npm --prefix apps/partner run android",
    "android:dispatch": "npm --prefix apps/dispatch run android",
    "lint:customer": "npm --prefix apps/customer run lint",
    "lint:partner": "npm --prefix apps/partner run lint",
    "lint:dispatch": "npm --prefix apps/dispatch run lint",
    "load:test": "node ./scripts/load-test-backend.mjs",
    "generate:rpc-routes": "node scripts/generate-rpc-routes.mjs",
    "test": "npm run test:node && npm run test:deno",
    "test:node": "node --test --experimental-strip-types packages/auth/src/authLoadingGuard.test.ts packages/auth/src/cacheHydration.test.ts packages/auth/src/supabaseAuth.test.ts packages/domain/src/phone.test.ts packages/domain/src/promoAttribution.test.ts packages/domain/src/rpcRoutes.test.ts packages/domain/src/rpcUrl.test.ts packages/runtime/src/visiblePoller.test.ts packages/runtime/src/realtimeResource.test.ts packages/runtime/src/useRealtimeResource.mount.test.ts apps/partner/src/utils/authActionUrls.test.ts apps/partner/src/contexts/partnerAuthFlow.test.ts apps/dispatch/src/contexts/dispatchAuthFlow.test.ts apps/customer/src/services/catalogCache.test.ts apps/customer/src/services/pagination.test.ts apps/customer/src/utils/restaurantAvailability.test.ts",
    "test:deno": "deno test -A --no-lock supabase/functions/_shared/media_test.ts supabase/functions/_shared/pricing.test.ts supabase/functions/_shared/partnerApplicationTransitions.test.ts supabase/functions/_shared/requireRole.test.ts supabase/functions/_shared/validation.test.ts supabase/functions/_shared/deliveryCoverage.test.ts supabase/functions/_shared/dispatchSelection.test.ts supabase/functions/_shared/partnerRestaurantScope.test.ts supabase/functions/_shared/promoTrack.test.ts supabase/functions/_shared/rpc/registry.test.ts supabase/functions/auth-gateway/errors.test.ts supabase/functions/auth-gateway/hash.test.ts supabase/functions/auth-gateway/router.test.ts supabase/functions/payment-verification/invariants.test.ts supabase/functions/paystack-webhook/invariants.test.ts supabase/functions/public-catalog/catalog.test.ts && deno test -A --no-lock --no-check supabase/functions/_shared/rpc/registry.real-domains.test.ts supabase/functions/_shared/rpc/serve.real-entrypoints.test.ts supabase/functions/_shared/domains/adminSetRestaurantPublished.test.ts",
    "deploy:paystack": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\deploy-paystack-functions.ps1",
    "deploy:functions": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\deploy-realtime-email-functions.ps1",
    "deploy:function": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\deploy-function.ps1"
  },
  "dependencies": {
    "@sentry/browser": "^10.62.0",
    "@supabase/supabase-js": "^2.105.4",
    "jose": "^6.2.3",
    "jwt-decode": "^4.0.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-webview": "^13.16.1"
  },
  "devDependencies": {
    "supabase": "^2.101.0"
  },
  "optionalDependencies": {
    "@supabase/cli-windows-x64": "^2.101.0"
  }
}
